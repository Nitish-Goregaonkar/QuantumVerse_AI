# --- LLM Provider ---
# Get your FREE API key at: https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# --- Model Settings ---
# Free Groq models: openai/gpt-oss-120b | llama3-8b-8192 | mixtral-8x7b-32768 | gemma2-9b-it
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_TOKENS=8192
TEMPERATURE=0.1

# --- Retrieval Settings ---
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.4
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Paths ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
KNOWLEDGE_GRAPH_PATH=data/knowledge_graph/knowledge_graph.json

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO
\n# Optional OCR: install Tesseract OCR separately and ensure it is on PATH.\n# For production, replace wildcard CORS with comma-separated trusted origins.\nCORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000\n
# --- V3 conversation and streaming ---
CONVERSATION_MEMORY_MESSAGES=12
CONVERSATION_CONTEXT_CHARS=2000

# --- Video input (requires FFmpeg on PATH and Groq audio transcription access) ---
VIDEO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
FFMPEG_BINARY=ffmpeg
